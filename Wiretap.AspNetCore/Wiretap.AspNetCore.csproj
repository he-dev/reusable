<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <LangVersion>default</LangVersion>
        <Nullable>enable</Nullable>
        <DebugType>full</DebugType>
        <RootNamespace>Reusable.Wiretap.AspNetCore</RootNamespace>
        <AssemblyName>Reusable.Wiretap.AspNetCore</AssemblyName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugSymbols>true</DebugSymbols>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DefineConstants>TRACE;RELEASE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wiretap\Wiretap.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="src\Mvc\Filters\**"/>
        <Compile Remove="src\Mvc\**"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="src\Mvc\Filters\**"/>
        <EmbeddedResource Remove="src\Mvc\**"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="src\Mvc\Filters\**"/>
        <None Remove="src\Mvc\**"/>
    </ItemGroup>

</Project>
